{
  "version": 2,
  "builds": [
    { "src": "server.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.ts" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*\\.(ico|js|css|png|svg|jpg|jpeg))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
